# musubi-tuner-colab-cli の設定。各スクリプトが bash で source する。
# 自分だけの値は同じフォルダーの config.local.env に書くと上書きできる。

# ===== Colab ランタイム =====
COLAB_SESSION=musubi-tuner    # colab CLI のセッション名。ssh_config の ProxyCommand にも渡る
GPU=L4                        # T4 / L4 / G4 / H100 / A100
HIGH_MEM=0                    # 1 なら --high-mem を付ける。Colab Pro/Pro+ が必要。L4 では無視される
EXPECT_GPU_REGEX=''           # nvidia-smi の GPU 名がこれに一致しないときは ON_GPU_MISMATCH に従う。空なら GPU の値で判定する
ON_GPU_MISMATCH=ask           # ask: 確認する / stop: ランタイムを止めて終了 / continue: そのまま続行

# ===== Google ドライブ =====
USE_DRIVE=ask                 # ask: ランタイムを作る前に尋ねる / 1: マウントする / 0: マウントしない
DRIVE_FOLDER=musubi-tuner-colab # マイドライブからの相対パス。models と outputs をこの下に置く

# ===== 学習 =====
SAVE_TO=ask                   # 学習したモデルの保存先。ask: 学習の前に尋ねる / local: 手元の PC / drive: Google ドライブ
PULL_INTERVAL_SEC=300         # SAVE_TO=local のとき、学習中に手元へコピーする間隔の秒数。0 なら学習の終了時だけコピーする
PULL_STATE=1                  # 1 なら再開用の -state フォルダーも手元へコピーする
STOP_AFTER_TRAINING=0         # 1 なら成功して保存を確かめた後にランタイムを削除する。0 なら残るので、stop.bat で削除する

# ===== Colab VM 側の Musubi Tuner =====
MUSUBI_REPO=https://github.com/kohya-ss/musubi-tuner.git
MUSUBI_REF=f8a1b03794a49239a3539015075f5123d6c07d66  # 既定のプリセットを確かめたコミット。latest なら既定のブランチの最新。ブランチ名やタグも指定できる。ランタイムの作成時に決まり、途中では更新しない
MUSUBI_EXTRA_PACKAGES=''      # 追加で入れる Python パッケージ。空白で区切る。例: 'wandb flash-attn'
APT_PACKAGES=''               # 追加で入れる apt パッケージ。空白で区切る
VM_ROOT=/content              # Colab VM 上でこのツールが使う場所
MODEL_CACHE_DRIVE=0           # 1 ならドライブ接続中に自動で取得したモデルをドライブにも保存し、次のランタイムで再利用する

# ===== 手元の WSL =====
MT_COLAB_LANG="${MT_COLAB_LANG:-}" # 表示する言語。空なら自動で、日本語の環境なら ja、それ以外は en。ja か en で固定できる
OUTPUT_DIR=outputs            # 学習したモデルのコピー先。相対パスはこのフォルダーから見た場所
PULL_OUTPUTS_ON_STOP=1        # 1 ならランタイムを削除する前に、VM に残っている学習結果を OUTPUT_DIR へコピーする

# 認証が必要なモデルや W&B のトークンは、このファイルではなく config.local.env に書く
# HF_TOKEN=hf_...
# CIVITAI_TOKEN=...
# WANDB_API_KEY=...
